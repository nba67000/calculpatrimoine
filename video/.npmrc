; Configuration npm locale au projet video/
; strict-ssl désactivé pour contourner l'erreur UNABLE_TO_VERIFY_LEAF_SIGNATURE
; (probablement causée par un antivirus ou un proxy d'entreprise qui inspecte le trafic HTTPS).
;
; Ce paramètre s'applique UNIQUEMENT aux installs dans ce dossier, pas à la config npm globale.
; Pour une solution propre à long terme : configurer NODE_EXTRA_CA_CERTS avec le certificat
; racine de l'antivirus/proxy, puis remettre strict-ssl=true.
strict-ssl=false
